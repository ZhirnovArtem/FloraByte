# Copy to .env and fill. Never commit .env.

APP_SECRET_KEY=
USE_STUB_SCANNERS=0

# LLM — OpenAI-compatible endpoint (Gemini example)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Telegram (prefer credentials store; env for quick local demo only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=sqlite:///./ai_security_workflow.db
GIT_CLONE_ALLOWLIST=https://github.com/TBagirov/training
