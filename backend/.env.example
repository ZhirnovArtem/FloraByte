# === Core ===
# Persistent Fernet key is strongly recommended; don't commit this value.
APP_SECRET_KEY=
# APP_SECRET_KEY_FILE=/path/to/persistent/secure.key
CI_TOKEN=
# Set before exposing the backend outside a trusted localhost/network.
WORKFLOW_ACCESS_TOKEN=
USE_STUB_SCANNERS=0

# === Database ===
DATABASE_URL=sqlite:///./ai_security_workflow.db

# === LLM (OpenAI-compatible) ===
# Cloud (Gemini example):
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Local Ollama example:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# === Telegram (prefer credentials API; env for quick demo only) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Webhook outbound policy ===
# Empty = public internet hosts only; to permit localhost for testing, explicitly set:
# WEBHOOK_HOST_ALLOWLIST=localhost
WEBHOOK_HOST_ALLOWLIST=

# === Git clone allowlist (comma-separated full HTTPS URLs) ===
GIT_CLONE_ALLOWLIST=https://github.com/TBagirov/training
