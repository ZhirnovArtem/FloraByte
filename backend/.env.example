# === Core ===
APP_SECRET_KEY=
USE_STUB_SCANNERS=0

# === Database ===
DATABASE_URL=sqlite:///./ai_security_workflow.db

# === LLM (OpenAI-compatible) ===
# Cloud (Gemini example):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Local Ollama example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# === Telegram (prefer credentials API; env for quick demo only) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Git clone allowlist (comma-separated full HTTPS URLs) ===
GIT_CLONE_ALLOWLIST=https://github.com/TBagirov/training
